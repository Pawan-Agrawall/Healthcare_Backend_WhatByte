                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "1"
              ]
            }
          }
        },
        {
          "name": "Update patient",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 35\n}"
            }
          }
        },
        {
          "name": "Delete patient",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/patients/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "1"
              ]
            }
          }
        }
      ]
